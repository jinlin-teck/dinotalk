# 可选：也可以直接在浏览器「家长控制台」页面可视化填写并保存至服务端 SQLite
# 注意：LLM_* 环境变量仅在首次初始化数据库（创建 kids.db）时写入默认设置；
# 数据库已存在后，请直接在家长控制台修改并保存模型配置。
DATA_DIR=./data

# 可选默认 LLM（OpenAI 兼容格式，例如 DeepSeek / 通义千问 / OpenAI / Gemini / Ollama）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 可选出站限制，适用于可配置的 LLM / TTS / STT HTTP 接口
# ALLOWED_ENDPOINT_HOSTS=api.deepseek.com,api.openai.com,api.minimax.cn
# BLOCK_PRIVATE_ENDPOINTS=1

# 可选入站限制：只允许这些 Host 访问 API，用于缓解 DNS rebinding。
# 支持精确匹配（含端口）与 .后缀 匹配；一旦设置，请务必包含你实际访问用的地址。
# ALLOWED_HOSTS=localhost:3000,192.168.0.3:3000,.home.arpa

# 仅在反向代理覆盖 X-Real-IP 且客户端不能直连应用时开启按 IP 限流。
# TRUST_PROXY_HEADERS=1

# 可选：家长会话签名密钥。不填会自动生成并保存在 DATA_DIR/.session-secret
# SESSION_SECRET=
